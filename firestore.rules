rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    // Replace this placeholder with the exact Google account email you own.
    // Do not rely on hiding the admin page URL.
    function isAdmin() {
      return signedIn() &&
        request.auth.token.email == "REPLACE_WITH_YOUR_GOOGLE_EMAIL" &&
        request.auth.token.email_verified == true;
    }
    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "request_received"
        && request.resource.data.paymentStatus == "not_requested"
        && request.resource.data.slotStatus == "pending"
        && request.resource.data.keys().hasOnly([
          "userId","customerName","customerEmail","contactEmail","whatsapp","city",
          "fulfilment","address","stickerType","material","size","quantity","finish",
          "cutStyle","artworkFileNames","description","slotPreference",
          "instagramDiscountRequested","status","paymentStatus","slotStatus","createdAt"
        ]);
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
